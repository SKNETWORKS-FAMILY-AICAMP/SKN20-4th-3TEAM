# Django 설정
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django

# FastAPI 설정
FASTAPI_URL=http://fastapi:8001

# OpenAI API (RAG 시스템에 필요)
OPENAI_API_KEY=your-openai-api-key-here

# 데이터베이스 설정
DATABASE_URL=sqlite:///./dog_chat.db

# CORS 설정
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# JWT 설정
SECRET_KEY=your-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ChromaDB 설정 (벡터 DB)
# 로컬 개발: ../data/ChromaDB_bge_m3
# 도커 환경: /app/data/ChromaDB_bge_m3
CHROMA_PERSIST_DIRECTORY=../data/ChromaDB_bge_m3
